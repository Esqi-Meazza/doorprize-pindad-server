{
  "name": "server",
  "private": true,
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "db:migrate": "node scripts/migrate.js",
    "test": "node --test --test-concurrency=1 tests/**/*.test.js",
    "test:integration": "set RUN_DB_TESTS=1&& node --test tests/integration.test.js",
    "test:race": "set RUN_DB_TESTS=1&& node --test tests/race.test.js",
    "format": "prettier --write server.js config/db.js middlewares controllers routes schemas services scripts tests",
    "format:check": "prettier --check server.js config/db.js middlewares controllers routes schemas services scripts tests .env.example README.md",
    "audit": "npm audit --audit-level=high"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "morgan": "^1.12.0",
    "mysql2": "^3.22.5",
    "socket.io": "^4.8.3",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "nodemon": "^3.1.10",
    "prettier": "^3.9.6"
  }
}
